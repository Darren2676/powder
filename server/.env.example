# 后端服务端口
PORT=3000

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=SEALSMES
DB_USER=sa
DB_PASSWORD=你的密码

# JWT 配置（生产环境务必修改为随机字符串）
JWT_SECRET=替换为随机字符串
JWT_EXPIRES_IN=24h

# 文件上传
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# 新核云开放平台配置
XHY_BASE_URL=https://c2.xinheyun.com
XHY_APP_KEY=你的APP_KEY
XHY_APP_SECRET=你的APP_SECRET
